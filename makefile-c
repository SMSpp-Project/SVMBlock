##############################################################################
################################ makefile-c ##################################
##############################################################################
#                                                                            #
#   complete makefile of SVMBlock                                            #
#                                                                            #
#   The makefile defines internally all external libraries (comprised the    #
#   SMS++ one) required by SVMBlock. Accordingly, all necessary              #
#   OBJ, H, -I directives, external libraries + -L< libdirs > are added to   #
#   the corresponding SVMBk* macros.                                         #
#                                                                            #
#   Input:  $(CC)        = compiler command                                  #
#           $(SW)        = compiler options                                  #
#           $(SVMBkSDR)  = the directory where SVMBlock source is            #
#           $(SVMBkODR)  = the directory where the objects have to be put    #
#                                                                            #
#   Output: $(SVMBkOBJ)  = the final object(s) / library                     #
#           $(SVMBkLIB)  = external libraries + -L< libdirs >                #
#            $(SVMBkH)    = the .h files to include for SVMBlock             #
#                $(SVMBkINC)  = the -I$( SVMBlock directory )                #
#                                                                            #
#                             Antonio Frangioni                              #
#                         Dipartimento di Informatica                        #
#                             Universita' di Pisa                            #
#                                                                            #
##############################################################################

# define & include the necessary modules- - - - - - - - - - - - - - - - - - -
# if a module is not used in the current configuration, just comment out the
# corresponding include line
# each module outputs some macros to be used here:
# *OBJ is the final object/library
# *H   is the list of all include files
# *INC is the -I< include directories >

# define input macros for SMS++ complete makefile, then include it
SMS++SDR = $(SVMBkSDR)/../SMS++
include $(SMS++SDR)/lib/makefile-c

# include the makefile requiring all external modules in input
include $(SVMBkSDR)/makefile

# macros to be exported - - - - - - - - - - - - - - - - - - - - - - - - - - -

# append external -I directives to SVMBkINC, SVMBkOBJ and SVMBkH as defined
# by the makefile, thus the := assignment has to be used (use GNU make)
SVMBkOBJ := $(SVMBkOBJ) $(SMS++OBJ)
SVMBkINC := $(SVMBkINC) $(SMS++INC)

# external libraries for SVMBlock
SVMBkLIB = $(SMS++LIB)

############################ End of makefile #################################
